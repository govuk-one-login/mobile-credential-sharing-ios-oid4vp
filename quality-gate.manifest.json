{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.14.0/schemas/schema.json",
  "services": [
    {
      "product": "Mobile Credential Sharing iOS",
      "component": "mobile-credential-sharing-ios",
      "promotionType": "other",
      "promotionTypeDetails": [
        "deploys library to a build account"
      ],
      "automated": [
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request.yml",
            "path": "$.jobs.validate_lint.steps[?@.name=='run_linter']"
          }
        },
        {
          "checkTypes": [
            "unit",
            "unit test coverage",
            "code quality"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request.yml",
            "path": "$.jobs.build.steps[?@.name=='build']"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "unit",
            "unit test coverage",
            "code quality"
          ],
          "phase": "build",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/quality-report.yml",
            "path": "$.jobs.build"
          }
        },
        {
          "checkTypes": [
            "manual"
          ],
          "phase": "build",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/deploy.yml",
            "path": "$.jobs.deploy"
          }
        }
      ]
    }
  ]
}
